---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { site, type Locale } from '../config';
import { getContent, publishedLocales, localePath } from '../i18n';
import hero from '../assets/images/hero.webp';
import storefront from '../assets/images/storefront-2026-2.jpg';
import logo from '../assets/brand/logo1.jpg';

interface Props {
  locale: Locale;
  /** Path of the page within a language, e.g. 'gallery/' ('' for the home page) */
  page?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Social-sharing text and image, when they differ from the SEO ones */
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: ImageMetadata;
  ogAlt?: string;
  /** Breadcrumb below Home, e.g. [{ name: 'Gallery', path: 'gallery/' }] (none on the home page) */
  breadcrumb?: { name: string; path: string }[];
  /** Extra structured-data nodes for this page (e.g. a Service) and the id of the page's main entity */
  schema?: Record<string, unknown>[];
  mainEntity?: string;
}
const {
  locale,
  page = '',
  title,
  description,
  noindex = false,
  ogTitle,
  ogDescription,
  ogImage,
  ogAlt,
  breadcrumb = [],
  schema = [],
  mainEntity,
} = Astro.props;
const t = getContent(locale);

const abs = (path: string) => new URL(path, site.url).href;
const canonical = abs(Astro.url.pathname);
const og = await getImage({ src: ogImage ?? hero, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const metaTitle = title ?? t.meta.title;
const socialTitle = ogTitle ?? title ?? t.meta.ogTitle ?? t.meta.title;
const metaDescription = description ?? t.meta.description;
const socialDescription = ogDescription ?? metaDescription;
const socialAlt = ogAlt ?? t.meta.ogAlt;
const ogLocale = { en: 'en_US', fr: 'fr_FR', km: 'km_KH' }[locale];
const indexable = t.published && !noindex;

// Structured data: one shared business record (same @id on every page), the website, this page and its breadcrumb,
// plus any page-specific nodes. Not emitted on noindex pages.
const businessId = `${site.url}/#business`;
const websiteId = `${site.url}/#website`;
const shopPhoto = await getImage({ src: storefront, width: 1200, format: 'jpg' });
const logoImage = await getImage({ src: logo, width: 512, format: 'jpg' });
const breadcrumbId = `${canonical}#breadcrumb`;
const graph = [
  {
    '@type': 'LocalBusiness',
    '@id': businessId,
    name: site.name,
    url: `${site.url}/`,
    image: abs(shopPhoto.src),
    logo: abs(logoImage.src),
    telephone: site.phone.href.replace('tel:', ''),
    description: t.meta.description,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.locality,
      addressCountry: site.address.country,
    },
    sameAs: [site.social.facebook, site.social.instagram, site.telegram],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${site.url}/`,
    name: site.name,
    publisher: { '@id': businessId },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: metaTitle,
    description: metaDescription,
    inLanguage: locale,
    isPartOf: { '@id': websiteId },
    ...(mainEntity ? { mainEntity: { '@id': mainEntity } } : {}),
    ...(breadcrumb.length ? { breadcrumb: { '@id': breadcrumbId } } : {}),
  },
  ...(breadcrumb.length
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': breadcrumbId,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: t.ui.home, item: abs(localePath(locale)) },
            ...breadcrumb.map((b, i) => ({
              '@type': 'ListItem',
              position: i + 2,
              name: b.name,
              item: abs(localePath(locale, b.path)),
            })),
          ],
        },
      ]
    : []),
  ...schema,
];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#10273d" />
    <link rel="canonical" href={canonical} />
    {
      publishedLocales.map((l) => (
        <link rel="alternate" hreflang={l} href={abs(localePath(l, page))} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs(localePath('en', page))} />
    <meta name="robots" content={indexable ? 'index,follow,max-image-preview:large' : 'noindex'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={abs(og.src)} />
    <meta name="twitter:image:alt" content={socialAlt} />

    {indexable && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Google Tag Manager, loaded once the page itself has finished loading -->
    <script is:inline define:vars={{ id: site.gtmId }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      window.addEventListener('load', function () {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=' + id;
        document.head.appendChild(s);
      });
    </script>
  </head>
  <body>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <a class="skip-link" href="#content">{t.ui.skip}</a>
    <slot />
    <script is:inline>
      // Scroll reveal: elements marked data-reveal fade in once as they enter the viewport.
      // Hidden-until-revealed styles only apply under .js and prefers-reduced-motion: no-preference.
      (function () {
        var items = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          items.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        items.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
