---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Locale } from '../config';
import { getContent, localePath } from '../i18n';
import { gallery } from '../data/gallery';

const { locale } = Astro.props as { locale: Locale };
const t = getContent(locale);
const g = t.gallery;

const files = import.meta.glob<ImageMetadata>('../assets/gallery/*.{webp,jpg,jpeg,png}', {
  eager: true,
  import: 'default',
});
const byName = new Map(
  Object.entries(files).map(([path, src]) => [path.split('/').pop()!.replace(/\.[^.]+$/, ''), src])
);

// Listed photos first, in order; any extra photo dropped into the folder follows (no description yet).
const listed = new Set(gallery.map((i) => i.file));
const extras = [...byName.keys()].filter((f) => !listed.has(f)).sort();
if (extras.length) console.warn(`[gallery] photos without an entry in src/data/gallery.ts: ${extras.join(', ')}`);
const entries = [
  ...gallery.map((i) => ({ file: i.file, alt: i.alt[locale as 'en' | 'fr'] ?? i.alt.en })),
  ...extras.map((file) => ({ file, alt: '' })),
];

const items = (
  await Promise.all(
    entries.map(async (e) => {
      const src = byName.get(e.file);
      if (!src) return null;
      const full = await getImage({ src, width: 1600, format: 'webp', quality: 80 });
      return { ...e, src, full: full.src };
    })
  )
).filter((i): i is NonNullable<typeof i> => i !== null);
---

<Layout locale={locale} page="gallery/" title={g.metaTitle} description={g.metaDescription}>
  <Header locale={locale} page="gallery/" />
  <main id="content">
    <section class="section gallery-head" aria-labelledby="gallery-title">
      <div class="wrap gallery-head__inner" data-reveal>
        <span class="rule" aria-hidden="true"></span>
        <h1 class="page-title" id="gallery-title">{g.title}</h1>
        <p>{g.intro}</p>
        <div>
          <a class="btn" href={localePath(locale) + '#form'}>{g.enquire}</a>
        </div>
      </div>
    </section>

    <section class="gallery" aria-label={g.title}>
      <div class="wrap">
        <ul class="gallery__grid">
          {
            items.map((item, i) => (
              <li class="gallery__item" data-reveal style={`--i: ${i % 3}`}>
                <a
                  class="gallery__thumb"
                  href={item.full}
                  data-index={i}
                  data-full={item.full}
                  data-alt={item.alt}
                  aria-label={item.alt ? `${g.openPhoto}: ${item.alt}` : g.openPhoto}
                >
                  <Image
                    src={item.src}
                    alt={item.alt}
                    widths={[360, 540, 720]}
                    sizes="(max-width: 40rem) 50vw, (max-width: 72rem) 33vw, 360px"
                    format="webp"
                    quality={75}
                    loading={i < 4 ? 'eager' : 'lazy'}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <dialog class="lightbox" aria-label={g.title} data-counter={g.counter}>
    <button class="lightbox__btn lightbox__close" type="button" data-action="close" aria-label={g.close}>×</button>
    <button class="lightbox__btn lightbox__prev" type="button" data-action="prev" aria-label={g.previous}>‹</button>
    <button class="lightbox__btn lightbox__next" type="button" data-action="next" aria-label={g.next}>›</button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
  </dialog>

  <Footer locale={locale} />
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const thumbs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.gallery__thumb'));

  if (dialog && thumbs.length) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const counter = dialog.dataset.counter ?? '{n} / {total}';
    let current = 0;

    const show = (index: number) => {
      current = (index + thumbs.length) % thumbs.length;
      const t = thumbs[current];
      img.src = t.dataset.full!;
      img.alt = t.dataset.alt ?? '';
      const count = counter.replace('{n}', String(current + 1)).replace('{total}', String(thumbs.length));
      caption.textContent = t.dataset.alt ? `${t.dataset.alt} · ${count}` : count;
      // warm the cache for the neighbours
      for (const n of [current + 1, current - 1]) {
        new Image().src = thumbs[(n + thumbs.length) % thumbs.length].dataset.full!;
      }
    };

    thumbs.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      })
    );

    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const action = target.closest<HTMLElement>('[data-action]')?.dataset.action;
      if (action === 'next') show(current + 1);
      else if (action === 'prev') show(current - 1);
      else if (action === 'close' || target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });

    // swipe
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.changedTouches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });

    // give focus back to the thumbnail that opened it
    dialog.addEventListener('close', () => thumbs[current]?.focus());
  }
</script>
