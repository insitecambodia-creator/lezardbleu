---
import { Image } from 'astro:assets';
import type { Locale } from '../config';
import { getContent } from '../i18n';
import { clients } from '../data/clients';

const { locale } = Astro.props as { locale: Locale };
const t = getContent(locale);

const files = import.meta.glob<ImageMetadata>('../assets/clients/*.{webp,png,jpg,jpeg,svg}', {
  eager: true,
  import: 'default',
});
const logos = clients.flatMap((c) => {
  const entry = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === c.file);
  return entry ? [{ ...c, src: entry[1] }] : [];
});
---

<section class="section" aria-labelledby="clients-title">
  <div class="wrap">
    <div class="clients__head">
      <div>
        <span class="rule" aria-hidden="true"></span>
        <h2 class="h2-small" id="clients-title">{t.clients.title}</h2>
      </div>
      <p>{t.clients.intro}</p>
    </div>
    <ul class="logos">
      {
        logos.map((c) => (
          <li>
            <a href={c.url} target="_blank" rel="noopener">
              <Image src={c.src} alt={c.name} widths={[160, 320]} sizes="160px" loading="lazy" format="webp" />
              <span class="visually-hidden"> ({t.ui.opensNewTab})</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="clients__more">{t.clients.more}</p>
  </div>
</section>
