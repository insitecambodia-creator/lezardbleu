---
import { Image } from 'astro:assets';
import type { Locale } from '../config';
import { getContent } from '../i18n';
import { clients } from '../data/clients';

const { locale } = Astro.props as { locale: Locale };
const t = getContent(locale);

const files = import.meta.glob<ImageMetadata>('../assets/clients/*.{webp,png,jpg,jpeg,svg}', {
  eager: true,
  import: 'default',
});
const logos = clients.flatMap((c) => {
  const entry = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === c.file);
  return entry ? [{ ...c, src: entry[1] }] : [];
});
---

<section class="section clients" aria-labelledby="clients-title">
  <div class="wrap">
    <div class="clients__head" data-reveal>
      <h2 id="clients-title">{t.clients.title}</h2>
      <p>{t.clients.intro}</p>
    </div>
    <ul class="logos">
      {
        logos.map((c, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a class="client-card" href={c.url} target="_blank" rel="noopener">
              <Image src={c.src} alt="" widths={[200, 320, 512]} sizes="(max-width: 40rem) 40vw, 180px" loading="lazy" format="webp" />
              <span class="client-card__name">{c.name}</span>
              <span class="client-card__more">
                {t.clients.readMore}
                <span class="visually-hidden"> ({t.ui.opensNewTab})</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="clients__more" data-reveal>{t.clients.more}</p>
  </div>
</section>
