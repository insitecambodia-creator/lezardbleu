---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { site, type Locale } from '../config';
import { getContent, localePath } from '../i18n';
import FrameAnatomy from './FrameAnatomy.astro';
import mouldings from '../assets/gallery/le-lezard-bleu2.webp';

const { locale } = Astro.props as { locale: Locale };
const p = getContent(locale).framingPage;
const page = 'custom-framing/';
const url = new URL(localePath(locale, page), site.url).href;
const quote = localePath(locale, 'framing-quote/');
// Sections after the hero alternate warm / white; n is the position (0 = warm)
const tone = (n: number) => (n % 2 === 0 ? 'section section--warm' : 'section');
const groupsStart = 2; // process (0) and anatomy (1) come first
const afterGroups = groupsStart + p.groups.length;

// Page-specific structured data (the business, website, page and breadcrumb come from the layout)
const service = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: p.service.name,
  serviceType: p.service.type,
  description: p.service.description,
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'City', name: 'Phnom Penh' },
};
---

<Layout
  locale={locale}
  page={page}
  title={p.metaTitle}
  description={p.metaDescription}
  ogTitle={p.ogTitle}
  ogDescription={p.ogDescription}
  ogImage={mouldings}
  ogAlt={p.ogAlt}
  breadcrumb={[{ name: p.crumb, path: page }]}
  schema={[service]}
  mainEntity={`${url}#service`}
>
  <Header locale={locale} page={page} />
  <main id="content">
    <section class="print-hero" aria-labelledby="framing-title">
      <div class="wrap print-hero__inner">
        <div class="print-hero__copy">
          <p class="eyebrow">{p.eyebrow}</p>
          <h1 id="framing-title">{p.title}</h1>
          <p class="print-hero__lead">{p.lead}</p>
          <div><a class="btn" href={quote}>{p.cta}</a></div>
        </div>
        <figure class="print-hero__figure">
          <Image
            src={mouldings}
            alt={p.imageAlt}
            widths={[480, 720, 1080]}
            sizes="(max-width: 48rem) 90vw, 560px"
            loading="eager"
            fetchpriority="high"
            format="webp"
          />
          <figcaption>{p.imageCaption}</figcaption>
        </figure>
      </div>
    </section>

    <section class={tone(0)} aria-labelledby="process-title">
      <div class="wrap print-grid">
        <div data-reveal>
          <span class="rule" aria-hidden="true"></span>
          <h2 id="process-title">{p.process.title}</h2>
          <p>{p.process.note}</p>
        </div>
        <ol class="steps" data-reveal style="--i: 1">
          {
            p.process.steps.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class={tone(1)} aria-labelledby="anatomy-title">
      <div class="wrap">
        <div class="anatomy__head" data-reveal>
          <span class="rule" aria-hidden="true"></span>
          <h2 id="anatomy-title">{p.anatomy.title}</h2>
          <p>{p.anatomy.text}</p>
        </div>
        <FrameAnatomy locale={locale} />
      </div>
    </section>

    {
      p.groups.map((g, i) => (
        <section class={tone(groupsStart + i)} aria-labelledby={`${g.id}-title`}>
          <div class="wrap print-grid">
            <div data-reveal>
              <span class="rule" aria-hidden="true" />
              <h2 id={`${g.id}-title`}>{g.title}</h2>
              <p>{g.text}</p>
              {g.note && <p>{g.note}</p>}
            </div>
            <dl class="options" data-reveal style="--i: 1">
              {
                g.items.map((item) => (
                  <div>
                    <dt>{item.name}</dt>
                    <dd>{item.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>
      ))
    }

    <section class={tone(afterGroups)} aria-labelledby="what-title">
      <div class="wrap print-grid">
        <div data-reveal>
          <span class="rule" aria-hidden="true"></span>
          <h2 id="what-title">{p.what.title}</h2>
          <p>{p.what.text}</p>
        </div>
        <ul class="specs" data-reveal style="--i: 1">
          {p.what.specs.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <section class={tone(afterGroups + 1)} aria-labelledby="printframe-title">
      <div class="wrap print-grid">
        <div data-reveal>
          <span class="rule" aria-hidden="true"></span>
          <h2 id="printframe-title">{p.printFrame.title}</h2>
        </div>
        <div data-reveal style="--i: 1">
          <p>{p.printFrame.text}</p>
          <p><a class="text-link" href={localePath(locale, 'fine-art-printing/')}>{p.printFrame.link}</a></p>
        </div>
      </div>
    </section>

    <section class={tone(afterGroups + 2)} aria-labelledby="faq-title">
      <div class="wrap faq" data-reveal>
        <span class="rule" aria-hidden="true"></span>
        <h2 id="faq-title">{p.faq.title}</h2>
        <dl>
          {
            p.faq.items.map((item) => (
              <div>
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section press" aria-labelledby="final-title">
      <div class="wrap press__inner" data-reveal>
        <h2 id="final-title" class="print-final__title">{p.final.title}</h2>
        <p class="print-final__text">{p.final.text}</p>
        <div><a class="btn" href={quote}>{p.final.cta}</a></div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
