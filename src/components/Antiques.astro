---
import { Image } from 'astro:assets';
import type { Locale } from '../config';
import { getContent, localePath } from '../i18n';
import photo from '../assets/gallery/le-lezard-bleu3.webp';

const { locale } = Astro.props as { locale: Locale };
const t = getContent(locale).antiques;
---

<section class="section section--warm" aria-labelledby="antiques-title">
  <div class="wrap split">
    <div class="split__body" data-reveal>
      <span class="rule" aria-hidden="true"></span>
      <h2 id="antiques-title">{t.title}</h2>
      {t.paragraphs.map((p) => <p>{p}</p>)}
      <a class="text-link" href={localePath(locale, 'gallery/')}>{t.galleryCta}</a>
    </div>
    <div class="split__media split__media--photo" data-reveal style="--i: 1">
      <Image
        src={photo}
        alt={t.imageAlt}
        widths={[480, 720, 1080]}
        sizes="(max-width: 48rem) 100vw, 50vw"
        format="webp"
        loading="lazy"
      />
    </div>
  </div>
</section>
