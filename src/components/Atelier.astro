---
import { site, type Locale } from '../config';
import { getContent } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = getContent(locale);
---

<section class="section" aria-labelledby="atelier-title">
  <div class="wrap atelier__grid">
    <div>
      <span class="rule" aria-hidden="true"></span>
      <h2 class="h2-small" id="atelier-title">{t.atelier.title}</h2>
    </div>
    <div class="atelier__body">
      {t.atelier.paragraphs.map((p) => <p>{p}</p>)}
      <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener">
        {t.atelier.cta}<span class="visually-hidden"> ({t.ui.opensNewTab})</span>
      </a>
    </div>
  </div>
</section>
