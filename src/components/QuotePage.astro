---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import QuoteForm from './QuoteForm.astro';
import type { Locale } from '../config';
import { getContent } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const q = getContent(locale).quote;
---

<Layout locale={locale} page="framing-quote/" title={q.metaTitle} description={q.metaDescription}>
  <Header locale={locale} page="framing-quote/" />
  <main id="content">
    <section class="section gallery-head" aria-labelledby="quote-title">
      <div class="wrap gallery-head__inner" data-reveal>
        <span class="rule" aria-hidden="true"></span>
        <h1 class="page-title" id="quote-title">{q.title}</h1>
        <p>{q.intro}</p>
      </div>
    </section>
    <QuoteForm locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
