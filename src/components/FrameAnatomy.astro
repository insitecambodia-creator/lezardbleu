---
import type { Locale } from '../config';
import { getContent } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const a = getContent(locale).framingPage.anatomy;

/**
 * Exploded view of a frame (artwork adapted from the owner's "Anatomy of a Framed Artwork" drawing).
 * The drawing has no text: names and descriptions come from the language files, so it works in every language.
 * Every layer sits at its drawn position when --t is 1 (pulled apart) and slides by (ax, ay) onto the frame
 * when --t is 0 (assembled). `mx, my` is where the numbered marker and its short leader line sit (layer coordinates).
 * Drawing order is back to front.
 */
const drawing = [
  { id: 'back', x: 660, y: 520, ax: -175, ay: -295, mx: 284, my: 60, edge: 250 },
  { id: 'backing', x: 625, y: 465, ax: -140, ay: -240, mx: 284, my: 60, edge: 250 },
  { id: 'artwork', x: 590, y: 410, ax: -105, ay: -185, mx: 249, my: 52, edge: 215 },
  { id: 'mount', x: 555, y: 350, ax: -70, ay: -125, mx: 294, my: 57, edge: 260 },
  { id: 'glazing', x: 520, y: 290, ax: -35, ay: -65, mx: 294, my: 57, edge: 260 },
  { id: 'frame', x: 485, y: 225, ax: 0, ay: 0, mx: 334, my: 60, edge: 300 },
  { id: 'hardware', x: 723, y: 660, ax: -238, ay: -435, mx: 112, my: 0, edge: 84 },
] as const;

// Number shown on each marker and in the list: front to back, as the text lists them
const number = Object.fromEntries(a.layers.map((l, i) => [l.id, i + 1]));
const first = a.layers[0].id;
---

<div class="anatomy" data-anatomy>
  <div class="anatomy__figure">
    <svg
      class="anatomy__svg"
      viewBox="130 20 860 750"
      role="img"
      aria-label={a.figureLabel}
      focusable="false"
    >
      <defs>
        <filter id="anat-shadow" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#10273D" flood-opacity="0.16"></feDropShadow>
        </filter>
        <filter id="anat-soft" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#10273D" flood-opacity="0.12"></feDropShadow>
        </filter>
        <linearGradient id="anat-wood" x1="0" x2="1">
          <stop offset="0" stop-color="#172D40"></stop>
          <stop offset="0.5" stop-color="#10273D"></stop>
          <stop offset="1" stop-color="#24445E"></stop>
        </linearGradient>
        <linearGradient id="anat-glass" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#EAF6FF" stop-opacity="0.68"></stop>
          <stop offset="0.5" stop-color="#FFFFFF" stop-opacity="0.18"></stop>
          <stop offset="1" stop-color="#CDE6F3" stop-opacity="0.48"></stop>
        </linearGradient>
        <linearGradient id="anat-art" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#FA7403"></stop>
          <stop offset="0.45" stop-color="#F1A45D"></stop>
          <stop offset="1" stop-color="#10273D"></stop>
        </linearGradient>
      </defs>

      {
        drawing.map((d) => (
          <g class={`anatomy__pos anatomy__pos--${d.id}`} style={`--ax:${d.ax};--ay:${d.ay}`}>
            <g class="anatomy__layer" data-layer={d.id} transform={`translate(${d.x} ${d.y})`}>
              <g filter={d.id === 'frame' ? 'url(#anat-shadow)' : 'url(#anat-soft)'}>
                {d.id === 'back' && (
                  <polygon points="-290,-145 250,-95 250,215 -290,165" fill="#D9D1C4" stroke="#B8AEA0" stroke-width="3" />
                )}
                {d.id === 'backing' && (
                  <polygon points="-290,-145 250,-95 250,215 -290,165" fill="#E7E2D8" stroke="#C7C0B5" stroke-width="3" />
                )}
                {d.id === 'artwork' && (
                  <>
                    <polygon points="-250,-125 215,-82 215,186 -250,143" fill="url(#anat-art)" stroke="#FFFFFF" stroke-width="8" />
                    <path d="M-220,80 C-145,20 -90,55 -20,-5 C65,-78 130,-28 185,-92" fill="none" stroke="#FFF3E5" stroke-width="14" opacity="0.85" />
                    <circle cx="110" cy="35" r="54" fill="#F9D7B5" opacity="0.72" />
                  </>
                )}
                {d.id === 'mount' && (
                  <path
                    d="M-300,-160 L260,-108 L260,222 L-300,170 Z M-235,-112 L192,-72 L192,167 L-235,127 Z"
                    fill="#FFFFFF"
                    fill-rule="evenodd"
                    stroke="#E5E5E5"
                    stroke-width="3"
                  />
                )}
                {d.id === 'glazing' && (
                  <>
                    <polygon points="-300,-160 260,-108 260,222 -300,170" fill="url(#anat-glass)" stroke="#AFD3E5" stroke-width="3" />
                    <path d="M-230,-126 L180,-88" stroke="#FFFFFF" stroke-width="12" opacity="0.62" />
                  </>
                )}
                {d.id === 'frame' && (
                  <>
                    <path
                      d="M-335,-190 L300,-132 L300,254 L-335,196 Z M-285,-138 L245,-88 L245,196 L-285,148 Z"
                      fill="url(#anat-wood)"
                      fill-rule="evenodd"
                    />
                    <path d="M-335,-190 L300,-132 L245,-88 L-285,-138 Z" fill="#2B4B64" opacity="0.8" />
                    <path d="M300,-132 L300,254 L245,196 L245,-88 Z" fill="#0A1B29" opacity="0.75" />
                    <path d="M-335,196 L300,254 L245,196 L-285,148 Z" fill="#071620" opacity="0.5" />
                  </>
                )}
                {d.id === 'hardware' && (
                  <>
                    <path d="M-120,0 C-60,-48 10,-48 75,0" fill="none" stroke="#6F6F6F" stroke-width="6" />
                    <circle cx="-120" cy="0" r="9" fill="#6F6F6F" />
                    <circle cx="75" cy="0" r="9" fill="#6F6F6F" />
                  </>
                )}
              </g>
              <g class="anatomy__marker">
                <line x1={d.edge} y1={d.my} x2={d.mx - 14} y2={d.my} stroke="#6E6E6E" stroke-width="2.5" />
                <circle cx={d.mx} cy={d.my} r="15" />
                <text x={d.mx} y={d.my} text-anchor="middle" dominant-baseline="central">{number[d.id]}</text>
              </g>
            </g>
          </g>
        ))
      }
    </svg>

    <div class="anatomy__control">
      <label for="anatomy-range">{a.sliderLabel}</label>
      <div class="anatomy__range">
        <span aria-hidden="true">{a.assembled}</span>
        <input id="anatomy-range" type="range" min="0" max="100" value="100" />
        <span aria-hidden="true">{a.exploded}</span>
      </div>
    </div>
  </div>

  <div class="anatomy__panel">
    <ol class="anatomy__list">
      {
        a.layers.map((l, i) => (
          <li class={`anatomy__item${l.id === first ? ' is-active' : ''}`} data-item={l.id}>
            <button
              type="button"
              class="anatomy__btn"
              aria-expanded={l.id === first ? 'true' : 'false'}
              aria-controls={`anatomy-${l.id}`}
            >
              <span class="anatomy__num" aria-hidden="true">{i + 1}</span>
              <span class="anatomy__name">{l.name}</span>
            </button>
            <div class="anatomy__more" id={`anatomy-${l.id}`}>
              <div>
                <p>{l.text}</p>
                {l.jump && (
                  <p>
                    <a class="text-link" href={`#${l.jump}-title`}>{a.jump}</a>
                  </p>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="anatomy__note">{a.note}</p>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-anatomy]');
    if (!root) return;
    var svg = root.querySelector('.anatomy__svg');
    var range = root.querySelector('input[type=range]');
    var layers = root.querySelectorAll('[data-layer]');
    var items = root.querySelectorAll('[data-item]');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var t = 1;
    var raf = 0;

    function setT(v) {
      t = v;
      svg.style.setProperty('--t', String(v));
      range.value = String(Math.round(v * 100));
    }
    function animate(to, delay) {
      cancelAnimationFrame(raf);
      if (reduce) return setT(to);
      var from = t;
      var start = null;
      var dur = 700;
      function step(ts) {
        if (start === null) start = ts;
        var p = Math.max(0, Math.min(1, (ts - start - (delay || 0)) / dur));
        setT(from + (to - from) * (1 - Math.pow(1 - p, 3)));
        if (p < 1) raf = requestAnimationFrame(step);
      }
      raf = requestAnimationFrame(step);
    }
    function select(id, userAction) {
      items.forEach(function (li) {
        var on = li.getAttribute('data-item') === id;
        li.classList.toggle('is-active', on);
        li.querySelector('button').setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      layers.forEach(function (g) {
        g.classList.toggle('is-active', g.getAttribute('data-layer') === id);
      });
      if (userAction) {
        svg.setAttribute('data-active', id);
        if (t < 0.6) animate(1);
      }
    }

    root.classList.add('is-enhanced');
    select(items[0].getAttribute('data-item'), false);

    items.forEach(function (li) {
      li.querySelector('button').addEventListener('click', function () {
        select(li.getAttribute('data-item'), true);
      });
    });
    layers.forEach(function (g) {
      var id = g.getAttribute('data-layer');
      g.addEventListener('click', function () { select(id, true); });
      g.addEventListener('pointerenter', function (e) {
        if (e.pointerType === 'mouse') select(id, true);
      });
    });
    range.addEventListener('input', function () {
      cancelAnimationFrame(raf);
      setT(range.value / 100);
    });

    // First view: start assembled and pull the layers apart once the figure is on screen
    if (!reduce && 'IntersectionObserver' in window) {
      setT(0);
      var io = new IntersectionObserver(
        function (entries) {
          if (entries[0].isIntersecting) {
            io.disconnect();
            animate(1, 250);
          }
        },
        { threshold: 0.35 }
      );
      io.observe(svg);
    }
  })();
</script>
